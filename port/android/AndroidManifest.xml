<?xml version="1.0" encoding="utf-8"?>
<!-- Settlers 3 Port: pure-native app (NativeActivity + libs3android.so). No game files are packaged. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.settlers3port.app"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- Online multiplayer: WebSocket connection to our relay (docs/porting/multiplayer.md). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:glEsVersion="0x00020000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Settlers 3 Port"
        android:icon="@drawable/ic_launcher"
        android:hasCode="false"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name="android.app.NativeActivity"
            android:label="Settlers 3 Port"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="s3android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
