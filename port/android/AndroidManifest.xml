<?xml version="1.0" encoding="utf-8"?>
<!-- Settlers 3 Port: NativeActivity + libs3android.so, plus one small Java service (GameService, background play).
     No game files are packaged. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.settlers3port.app"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- Online multiplayer: WebSocket connection to our relay (docs/porting/multiplayer.md). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Background play (docs/porting/android.md): foreground service + notifications, CPU awake while it runs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:glEsVersion="0x00020000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Settlers 3 Port"
        android:icon="@drawable/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name="android.app.NativeActivity"
            android:label="Settlers 3 Port"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="s3android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.settlers3port.app.GameService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A started single-player or multiplayer game keeps running (game simulation) while the app is in the background" />
        </service>
    </application>
</manifest>
