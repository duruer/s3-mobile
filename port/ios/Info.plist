<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Settlers 3 Mobile</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- ProMotion (iPhone 13 Pro and later): without this, iPhone apps are capped at 60 Hz. -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <!-- Documents (game files in Settlers3/, logs in Data/) visible in the Files app and over USB. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <!-- LAN games (relay + UDP discovery) and the upload server. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Settlers 3 Mobile finds and joins LAN games and receives your game files from a browser on this network.</string>
</dict>
</plist>
