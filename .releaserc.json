{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "New" },
            { "type": "fix", "section": "Fixed" },
            { "type": "perf", "section": "Faster" },
            { "type": "docs", "hidden": true },
            { "type": "chore", "hidden": true },
            { "type": "refactor", "hidden": true },
            { "type": "test", "hidden": true },
            { "type": "ci", "hidden": true },
            { "type": "build", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/exec",
      {
        "generateNotesCmd": "bash .github/release/notes.sh ${nextRelease.version}",
        "prepareCmd": "bash .github/release/build.sh ${nextRelease.version}",
        "successCmd": "echo version=${nextRelease.version} >> \"$GITHUB_OUTPUT\""
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "dist/*.apk" }],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
